# PR Sage environment variables
# Copy this to .env.local and fill in your values

# ---------------------------------------------------------------------------
# Vercel AI Gateway (required)
# Get your key: https://vercel.com/docs/ai-gateway/getting-started
# On Vercel deployments this is auto-injected via OIDC — only needed locally.
# ---------------------------------------------------------------------------
AI_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# GitHub App credentials (required for GitHub integration)
# Create a GitHub App: https://docs.github.com/en/apps/creating-github-apps
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Vercel Blob (required for storing review artifacts)
# Automatically set when you connect a Blob store in the Vercel dashboard.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# App config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
