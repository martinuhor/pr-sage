# PR Sage environment variables
# Copy this to .env.local and fill in your values

# ---------------------------------------------------------------------------
# Model provider (choose one)
#
# The agent resolves its provider at request time (see resolveProvider in
# src/lib/agent/reviewer.ts). Supplying GOOGLE_GENERATIVE_AI_API_KEY switches
# the agent to Google AI Studio, which has a free tier; otherwise it uses the
# Vercel AI Gateway. REVIEW_PROVIDER forces either side explicitly.
# ---------------------------------------------------------------------------

# --- Vercel AI Gateway (default) ---
# Get a key: https://vercel.com/docs/ai-gateway/getting-started
# On Vercel deployments this is auto-injected via OIDC — only needed locally.
# Note: the Gateway requires billing verification on the account.
AI_GATEWAY_API_KEY=

# --- Google AI Studio (free tier, no payment method required) ---
# Get a key: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional overrides. REVIEW_MODEL is the model id for the resolved provider:
# Gateway ids look like "vendor/model", Google ids are bare.
REVIEW_PROVIDER=
REVIEW_MODEL=

# ---------------------------------------------------------------------------
# GitHub App credentials (required for GitHub integration)
# Create a GitHub App: https://docs.github.com/en/apps/creating-github-apps
# GITHUB_APP_PRIVATE_KEY takes the PEM contents; literal "\n" escapes are fine.
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Tests only — points Octokit at a local server instead of api.github.com.
# Leave unset in development and production.
# ---------------------------------------------------------------------------
# GITHUB_API_BASE_URL=
